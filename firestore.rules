rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tus datos: tu propia cuenta, o tus dos cuentas autorizadas (Gmail personal y la de la U) sobre los datos de la dueña
    function esAliz() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email in ['alizz.mejia03@gmail.com', 'azmejiaf@ut.edu.co'];
    }
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && (request.auth.uid == uid || esAliz());
    }
    // Tokens cifrados de Google y Tu Aula: el navegador NUNCA puede leerlos (solo el servidor con Admin SDK)
    match /secrets/{document=**} {
      allow read, write: if false;
    }
  }
}
