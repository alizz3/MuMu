<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp"
    android:background="@drawable/widget_fondo">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@mipmap/ic_launcher" android:contentDescription="MuMu"/>
        <TextView android:id="@+id/w_line" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:text="MuMu" android:textColor="#3B2A3F" android:textStyle="bold" android:textSize="14sp" android:maxLines="2" android:ellipsize="end"/>
        <ImageView android:id="@+id/w_ref" android:layout_width="28dp" android:layout_height="28dp" android:padding="4dp" android:src="@drawable/ic_refrescar" android:contentDescription="Actualizar"/>
    </LinearLayout>

    <TextView android:id="@+id/w_t1" style="@style/WidgetFila"/>
    <TextView android:id="@+id/w_t2" style="@style/WidgetFila"/>
    <TextView android:id="@+id/w_t3" style="@style/WidgetFila"/>
    <TextView android:id="@+id/w_t4" style="@style/WidgetFila"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
        <TextView android:id="@+id/w_hab" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#8E5C9E" android:textSize="12sp"/>
        <TextView android:id="@+id/w_casa" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ya llegué"
            android:textColor="#FFFFFF" android:textSize="13sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="7dp" android:paddingBottom="7dp"
            android:background="@drawable/widget_boton2" android:layout_marginEnd="6dp"/>
        <TextView android:id="@+id/w_add" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+ Tarea"
            android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="13sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="7dp" android:paddingBottom="7dp"
            android:background="@drawable/widget_boton"/>
    </LinearLayout>
</LinearLayout>
