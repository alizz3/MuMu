<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Tema.MuMu" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/crema</item>
        <item name="android:statusBarColor">@color/rosa</item>
        <item name="android:navigationBarColor">@color/crema</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="WidgetFila">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">#5B4A5F</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="Tema.Alarma" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF15101A</item>
        <item name="android:statusBarColor">#FF15101A</item>
        <item name="android:navigationBarColor">#FF15101A</item>
    </style>
</resources>
