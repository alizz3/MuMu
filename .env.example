# ───────── Frontend (públicas por diseño: la config web de Firebase no es secreta) ─────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ───────── Servidor (SECRETAS: solo en Vercel → Settings → Environment Variables, nunca en GitHub) ─────────
APP_URL=https://tu-app.vercel.app
APP_TIMEZONE=America/Bogota
ALLOWED_EMAILS=tu-correo@gmail.com
# JSON de la cuenta de servicio de Firebase, en base64:  base64 -w0 serviceAccount.json
FIREBASE_SERVICE_ACCOUNT=
# 32 bytes aleatorios en base64:  openssl rand -base64 32
TOKEN_ENC_KEY=
# Google Cloud → APIs y servicios → Credenciales → ID de cliente OAuth (aplicación web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
UNIVERSITY_EMAIL_DOMAIN=ut.edu.co
# Vercel lo envía al cron automáticamente:  openssl rand -hex 24
CRON_SECRET=
# Opcional: asistente con IA
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Opcional: app de finanzas
FINANCE_API_URL=
FINANCE_API_KEY=
